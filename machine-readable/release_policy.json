{
  "schemaVersion": 1,
  "workspaceVersion": "0.1.0-dev.21",
  "hashAlgorithm": "SHA-256",
  "forbiddenHashAlgorithms": [
    "MD5",
    "SHA-1"
  ],
  "ciProvenance": {
    "externalActionsPinnedToFullSha": true,
    "pinAuthority": "machine-readable/ci_action_pins.json",
    "verifier": "scripts/verify_ci_actions.py",
    "checkoutPersistCredentials": false,
    "workflowPermissions": {
      "contents": "read"
    },
    "jobTimeoutMinutes": {
      "main-authority-continuity": 5,
      "managed": 30,
      "supply-chain-static": 15
    },
    "pythonDependencies": "hash-locked --require-hashes --only-binary=:all:"
  },
  "repositoryGovernance": {
    "desiredFutureMain": "block force-push/deletion; restrict updates; exact required checks and linear history where exact-candidate compatible; prospective verified signatures",
    "liveRulesetsConfigured": false,
    "liveMainBranchProtection": false,
    "historicalUnsignedDev20MustNotBeRewritten": true
  },
  "dependencyAudit": {
    "enabled": true,
    "mode": "all",
    "level": "low",
    "auditSource": "https://data.nuget.org/v3/index.json",
    "reportFormat": "dotnet-package-list-json-v1",
    "verifier": "scripts/verify_dependency_audit.py"
  },
  "signing": {
    "privateKeysInWorkspace": false,
    "requireTimestamp": true,
    "requiredWindowsArtifactVerification": [
      "Authenticode signature validation",
      "package signature validation where applicable",
      "SHA-256 manifest match"
    ],
    "keyCustody": "external release infrastructure only"
  },
  "workspacePackaging": {
    "forbiddenSuffixes": [
      ".pfx",
      ".p12",
      ".key",
      ".pem"
    ],
    "forbiddenNames": [
      ".env"
    ],
    "note": "Public certificates may use .cer/.crt; private-key-bearing formats are excluded. Disposable build/test/media output is excluded by workspace file policy."
  },
  "releasePrerequisites": [
    "all packages.lock.json present and reviewed",
    "locked restore passes",
    "NuGet audit covers direct and transitive dependencies at low severity threshold",
    "machine-readable dependency vulnerability report passes",
    "managed Release build passes",
    "managed and static tests pass",
    "headed Windows 11 Explorer acceptance passes",
    "restricted ProbeWorker/EngineWorker and actual ffprobe/ffmpeg descendant containment passes",
    "production engine redistribution/license/signature/hash policy is approved",
    "signed package and clean Windows 11 VM lifecycle acceptance pass",
    "release SBOM generated and reviewed",
    "required live repository governance is configured and verified"
  ]
}
