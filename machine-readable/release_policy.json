{
  "schemaVersion": 1,
  "workspaceVersion": "0.1.0-dev.19",
  "hashAlgorithm": "SHA-256",
  "forbiddenHashAlgorithms": ["MD5", "SHA-1"],
  "ciProvenance": {
    "externalActionsPinnedToFullSha": true,
    "pinAuthority": "machine-readable/ci_action_pins.json",
    "verifier": "scripts/verify_ci_actions.py",
    "checkoutPersistCredentials": false,
    "workflowPermissions": {"contents": "read"},
    "jobTimeoutMinutes": {"main-authority-continuity": 5, "managed": 30, "supply-chain-static": 15}
  },
  "dependencyAudit": {
    "enabled": true,
    "mode": "all",
    "level": "low",
    "auditSource": "https://data.nuget.org/v3/index.json",
    "reportFormat": "dotnet-package-list-json-v1",
    "verifier": "scripts/verify_dependency_audit.py"
  },
  "signing": {
    "privateKeysInWorkspace": false,
    "requireTimestamp": true,
    "requiredWindowsArtifactVerification": ["Authenticode signature validation", "package signature validation where applicable", "SHA-256 manifest match"],
    "keyCustody": "external release infrastructure only"
  },
  "workspacePackaging": {
    "forbiddenSuffixes": [".pfx", ".p12", ".key", ".pem"],
    "forbiddenNames": [".env"],
    "note": "Public certificates may use .cer/.crt; private-key-bearing formats are excluded. Disposable build/test/media output is excluded by workspace file policy."
  },
  "releasePrerequisites": [
    "all packages.lock.json present and reviewed",
    "locked restore passes",
    "NuGet audit covers direct and transitive dependencies at low severity threshold",
    "machine-readable dependency vulnerability report passes",
    "managed Release build passes",
    "managed and static tests pass",
    "headed Windows 11 Explorer acceptance passes",
    "restricted worker containment passes",
    "production engine redistribution/license/signature policy is approved",
    "signed package and clean Windows 11 VM lifecycle acceptance pass",
    "release SBOM generated and reviewed"
  ]
}
