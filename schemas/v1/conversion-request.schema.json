{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fileconvert.invalid/schemas/v1/conversion-request.schema.json",
  "title": "FileConvert Conversion Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "action", "files"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "action": { "type": "string", "enum": ["convertUsingDefault", "convertToFormat", "convertWithPreset"] },
    "files": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "string", "minLength": 1, "maxLength": 32767, "pattern": "^[^\\u0000]+$" } },
    "targetFormat": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "presetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
  },
  "allOf": [
    { "if": { "properties": { "action": { "const": "convertUsingDefault" } }, "required": ["action"] }, "then": { "not": { "anyOf": [{"required":["targetFormat"]},{"required":["presetId"]}] } } },
    { "if": { "properties": { "action": { "const": "convertToFormat" } }, "required": ["action"] }, "then": { "required": ["targetFormat"], "not": { "required": ["presetId"] } } },
    { "if": { "properties": { "action": { "const": "convertWithPreset" } }, "required": ["action"] }, "then": { "required": ["presetId"], "not": { "required": ["targetFormat"] } } }
  ]
}
