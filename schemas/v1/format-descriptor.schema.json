{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fileconvert.invalid/schemas/v1/format-descriptor.schema.json",
  "title": "FileConvert Format Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "familyId", "displayName", "canonicalExtension", "extensions"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "familyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "canonicalExtension": { "type": "string", "pattern": "^\\.[a-z0-9]{1,16}$" },
    "extensions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[a-z0-9]{1,16}$" } }
  }
}
