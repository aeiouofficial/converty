{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converty.invalid/schemas/v1/provider-capability.schema.json",
  "title": "Converty Provider Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "sourceFormat", "targetFormat", "mode", "priority"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "providerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sourceFormat": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "targetFormat": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "mode": { "type": "string", "enum": ["copy", "remux", "transcode", "transform"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000 }
  }
}
