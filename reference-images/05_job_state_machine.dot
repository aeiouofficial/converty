digraph G {
 graph [bgcolor="#101318", pad="0.25", nodesep="0.42", ranksep="0.55", fontname="Arial", fontcolor="#E8ECF1"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#607080", fontcolor="#F6F8FA", fillcolor="#1B232D", penwidth=1.2, margin="0.14,0.08"]; edge [fontname="Arial", fontsize=9, color="#8A99A8", fontcolor="#D9E1E8", arrowsize=0.75, penwidth=1.2]; rankdir=LR; node [shape=ellipse, width=1.3]; created [label="Created"]; validated [label="Validated"]; staged [label="Staged"]; probing [label="Probing"]; planned [label="Planned"]; running [label="Running"]; verifying [label="Verifying"]; committing [label="Committing"]; done [label="Completed", fillcolor="#1F3A2B"]; failed [label="Failed", fillcolor="#45282B"]; cancel [label="Cancelled", fillcolor="#453B28"]; reject [label="Rejected", fillcolor="#45282B"]; created->validated->staged->probing->planned->running->verifying->committing->done; created->reject [label="invalid request"]; validated->reject [label="policy"]; probing->reject [label="unsupported/mismatch"]; staged->failed; probing->failed; running->failed; verifying->failed; committing->failed; validated->cancel; staged->cancel; probing->cancel; planned->cancel; running->cancel; verifying->cancel; failed->failed [label="idempotent cleanup", style=dotted]; cancel->cancel [label="idempotent cleanup", style=dotted];
