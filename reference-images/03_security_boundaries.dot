digraph G {
 graph [bgcolor="#101318", pad="0.25", nodesep="0.42", ranksep="0.55", fontname="Arial", fontcolor="#E8ECF1"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#607080", fontcolor="#F6F8FA", fillcolor="#1B232D", penwidth=1.2, margin="0.14,0.08"]; edge [fontname="Arial", fontsize=9, color="#8A99A8", fontcolor="#D9E1E8", arrowsize=0.75, penwidth=1.2]; rankdir=TB;
 attacker [shape=ellipse, label="UNTRUSTED INPUT / MALICIOUS FILE\npolyglot • malformed codec • resource bomb • hostile filename", fillcolor="#4A2428", color="#B56A70"]; worker [label="Disposable Engine Worker\nAppContainer/isolated profile where compatible\nRestricted token fallback policy\nNo network • no clipboard/UI\nMitigations + Job Object\nOnly staged paths visible", fillcolor="#35262A"]; coordinator [label="Coordinator Host\nNever loads codec/plugin DLLs\nNever parses full media\nValidates typed results only\nNo elevation", fillcolor="#203329"]; shell [label="Explorer Shell DLL\nMinimal native code\nNo disk scan/network/codec\nFast return", fillcolor="#26384A"]; output [label="Output Transaction Boundary\nprivate temp → validate → final rename\nnever direct overwrite", fillcolor="#302C24"]; plugin [label="Plugin Supply-Chain Gate\nmanifest + API version + publisher/signature/hash\ncode executes only in worker", fillcolor="#2C2B3D"]; ipc [label="IPC Gate\nexplicit DACL • peer PID/image verification\nversioned schema • size/count/time bounds", fillcolor="#203329"]; deps [label="Binary Supply-Chain Gate\nPinned dependencies • SBOM • signatures/hashes\nSafe DLL search path", fillcolor="#2C2B3D"]; network [shape=octagon, label="NETWORK\nDENIED BY DEFAULT", fillcolor="#412629", color="#B56A70"]; attacker -> worker [label="only parser exposure"]; worker -> coordinator [label="bounded structured response"]; coordinator -> output; shell -> ipc -> coordinator; plugin -> worker; deps -> shell; deps -> coordinator; deps -> worker; worker -> network [label="blocked", style=dashed, arrowhead=tee, color="#D0747A"]; attacker -> coordinator [label="blocked by staging + process boundary", style=dashed, arrowhead=tee, color="#D0747A"]; attacker -> shell [label="no parsing", style=dashed, arrowhead=tee, color="#D0747A"];
}
