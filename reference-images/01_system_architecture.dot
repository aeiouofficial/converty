digraph G {
 graph [bgcolor="#101318", pad="0.25", nodesep="0.42", ranksep="0.55", fontname="Arial", fontcolor="#E8ECF1"];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#607080", fontcolor="#F6F8FA", fillcolor="#1B232D", penwidth=1.2, margin="0.14,0.08"];
 edge [fontname="Arial", fontsize=9, color="#8A99A8", fontcolor="#D9E1E8", arrowsize=0.75, penwidth=1.2];
 rankdir=TB;
 subgraph cluster_shell { label="TRUST ZONE A — EXPLORER SHELL PATH"; color="#4B6E8A"; fontcolor="#A9C6DF"; explorer [label="Windows 11 File Explorer\nRight-click selection", fillcolor="#243140"]; shell [label="FileConvert.ShellExtension.dll\nNative C++ / IExplorerCommand\nNO parsing • NO codecs • NO network\nFast menu metadata + Invoke handoff", fillcolor="#26384A"]; bridge [label="FileConvert.Bridge.exe\nTiny signed handoff process\nBounds selection + forwards request", fillcolor="#26384A"]; explorer -> shell [label="IExplorerCommand"]; shell -> bridge [label="Invoke / selection handoff"]; }
 subgraph cluster_coord { label="TRUST ZONE B — COORDINATOR"; color="#557A62"; fontcolor="#B5D5BD"; host [label="FileConvert.Host.exe (.NET 10 LTS)\nSingle-instance coordinator", fillcolor="#203329"]; ipc [label="Authenticated IPC Gateway\nACL + peer verification + schema limits", fillcolor="#203329"]; planner [label="Policy + Capability Planner\nFormat registry • presets • defaults\nNo untrusted media parsing", fillcolor="#203329"]; queue [label="Job Manager / Journal\nBounded queue • cancellation • recovery", fillcolor="#203329"]; broker [label="Engine Broker\nCreates per-job sandbox + resource limits", fillcolor="#203329"]; committer [label="Output Committer\nTemp output → validate → atomic final commit", fillcolor="#203329"]; ipc -> host -> planner -> queue -> broker; queue -> committer [style=dashed, label="after worker success"]; }
 subgraph cluster_worker { label="TRUST ZONE C — DISPOSABLE UNTRUSTED-PARSER WORKER"; color="#8A5C5C"; fontcolor="#E0B2B2"; worker [label="FileConvert.EngineWorker.exe\nPer-job / sandboxed / no ambient authority", fillcolor="#3A2528"]; probe [label="Probe Provider\nffprobe / image probe / future parser", fillcolor="#3A2528"]; engine [label="Conversion Provider\nFFmpeg • WIC worker • future signed plugin", fillcolor="#3A2528"]; worker -> probe; worker -> engine; }
 stage [label="Per-job staging area\nRead-only staged input\nWrite-only-by-policy temp output", fillcolor="#302C24"]; final [label="User destination\nFinal file only after validation", fillcolor="#302C24"];
 bridge -> ipc [label="versioned request", color="#73A2C6"]; broker -> stage [label="stage / grant minimal access"]; broker -> worker [label="launch under containment", color="#D38B8B"]; stage -> worker [dir=both, label="minimal file scope"]; worker -> committer [label="structured result only", color="#D38B8B"]; committer -> final [label="safe commit", color="#C6B273"];
}
