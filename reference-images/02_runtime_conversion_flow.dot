digraph G {
 graph [bgcolor="#101318", pad="0.25", nodesep="0.42", ranksep="0.55", fontname="Arial", fontcolor="#E8ECF1"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#607080", fontcolor="#F6F8FA", fillcolor="#1B232D", penwidth=1.2, margin="0.14,0.08"]; edge [fontname="Arial", fontsize=9, color="#8A99A8", fontcolor="#D9E1E8", arrowsize=0.75, penwidth=1.2]; rankdir=LR; node [width=2.0];
 sel [label="1. User selects files\nRight-click → Convert"]; menu [label="2. Shell command\nExtension-hint only\nNo media probe"]; req [label="3. Bridge + IPC\nBound request size\nCanonical schema"]; val [label="4. Coordinator validation\nPaths • policy • preset\nselection limits"]; stage [label="5. Stage job\nReserve destination\nCreate private temp"]; sbox [label="6. Launch worker\nSandbox + Job Object\nNo network"]; probe [label="7. Probe actual format\nInside worker"]; plan [label="8. Validate capability\nReject mismatch / unsupported"]; conv [label="9. Convert/remux\nEngine writes temp only"]; verify [label="10. Independent validation\nMagic/size + sandbox probe"]; commit [label="11. Atomic commit\nNumber/skip/replace policy"]; notify [label="12. Notify + journal\nNo media content in logs"]; sel->menu->req->val->stage->sbox->probe->plan->conv->verify->commit->notify; plan->notify [label="reject safely", style=dashed, color="#C47B7B"]; conv->notify [label="failure cleanup", style=dashed, color="#C47B7B"]; verify->notify [label="invalid output cleanup", style=dashed, color="#C47B7B"];
