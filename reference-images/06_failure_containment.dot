digraph G {
 graph [bgcolor="#101318", pad="0.25", nodesep="0.42", ranksep="0.55", fontname="Arial", fontcolor="#E8ECF1"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#607080", fontcolor="#F6F8FA", fillcolor="#1B232D", penwidth=1.2, margin="0.14,0.08"]; edge [fontname="Arial", fontsize=9, color="#8A99A8", fontcolor="#D9E1E8", arrowsize=0.75, penwidth=1.2]; rankdir=TB; root [label="A conversion fails or behaves maliciously", fillcolor="#4A2428"]; crash [label="Worker crash / codec RCE"]; bomb [label="CPU / RAM / output-size bomb"]; disk [label="Disk full / denied destination"]; race [label="Input changes / reparse / path race"]; ipcf [label="Malformed/spoofed IPC"]; plug [label="Tampered engine/plugin"]; contain1 [label="Worker dies with job\nKill-on-close + sandbox\nCoordinator stays alive", fillcolor="#203329"]; contain2 [label="Resource ceilings trigger\nWorker terminated\nNo final output", fillcolor="#203329"]; contain3 [label="Temp write fails\nNo final commit\nPartial cleaned/quarantined", fillcolor="#203329"]; contain4 [label="Handle/path identity revalidated\nCommit aborted on mismatch", fillcolor="#203329"]; contain5 [label="Schema/peer gate rejects\nNo job created", fillcolor="#203329"]; contain6 [label="Signature/hash/API gate rejects\nProvider never executes", fillcolor="#203329"]; root->{crash bomb disk race ipcf plug}; crash->contain1; bomb->contain2; disk->contain3; race->contain4; ipcf->contain5; plug->contain6; result [label="Required invariant:\nOriginal input unchanged\nNo unrelated user file modified\nNo ambient network access\nNo false 'success'\nRecoverable coordinator state", fillcolor="#23303A"]; {contain1 contain2 contain3 contain4 contain5 contain6}->result;
}
