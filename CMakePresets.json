{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-smoke",
      "displayName": "Native topology smoke",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/artifacts/native-smoke",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-smoke",
      "configurePreset": "native-smoke"
    }
  ]
}
